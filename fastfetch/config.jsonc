{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 1
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "bright_white",
      "title": "bright_cyan"
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "key": "\u001b[1;95m┌    Host      \u001b[0m"
    },

    {
      "type": "os",
      "key": "\u001b[1;93m├  󰣇  OS Name   \u001b[0m"
    },

    {
      "type": "kernel",
      "key": "\u001b[1;92m└    Kernel    \u001b[0m"
    },

    {
      "type": "shell",
      "key": "\u001b[1;96m┌    Shell     \u001b[0m"
    },

    {
      "type": "de",
      "key": "\u001b[1;94m├    DE        \u001b[0m"
    },

    {
      "type": "terminal",
      "key": "\u001b[1;91m└    Terminal  \u001b[0m"
    },

    {
      "type": "cpu",
      "key": "\u001b[1;97m┌    CPU       \u001b[0m",
      "temp": false,
      "showPeCoreCount": false
    },

    {
      "type": "memory",
      "key": "\u001b[1;95m├    RAM       \u001b[0m",

      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },

    {
      "type": "disk",
      "key": "\u001b[1;93m└    ROM       \u001b[0m",

      "showRegular": true,
      "showExternal": false,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": false,
      "showUnknown": false,

      "folders": "/",

      "hideFolders": "/efi:/boot:/boot/*:/home/saturn/*:/run/*",
      "hideFS": "",
      "useAvailable": false,

      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },

    "break"
  ]
}
